{
  "expo": {
    "name": "wesiq",
    "slug": "wesiq",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "wesiq",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tvoje.wesiq",
      "associatedDomains": [
        "applinks:wesiq.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tvoje.wesiq",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "wesiq.com",
              "pathPrefix": "/password-reset"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#060b18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_HEART_RATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060b18",
          "dark": {
            "backgroundColor": "#060b18"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wesiq needs access to your photos so you can share them in posts and chats and set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Wesiq uses Bluetooth to connect to your heart rate monitor during workouts."
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Wesiq reads your heart rate from Apple Health to show it while you record a workout.",
          "healthUpdatePermission": "Wesiq only reads your heart rate and never changes your Apple Health data."
        }
      ],
      "react-native-health-connect",
      "expo-sharing",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c007e0da-9003-4e39-953f-bbc4e5f2a6f6"
      }
    },
    "backgroundColor": "#060b18",
    "locales": {
      "en": "./locales/native/en.json",
      "sk": "./locales/native/sk.json",
      "cs": "./locales/native/cs.json",
      "de": "./locales/native/de.json",
      "es": "./locales/native/es.json",
      "fr": "./locales/native/fr.json",
      "uk": "./locales/native/uk.json",
      "ru": "./locales/native/ru.json",
      "pt-BR": "./locales/native/pt-BR.json"
    }
  }
}
